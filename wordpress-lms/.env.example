# Copy this file to ".env" and change the values before going anywhere near production.
# For local-only use, the defaults are fine.

# --- Database ---
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=rootpass

# --- Site ---
# The port you'll open in your browser: http://localhost:8080
WP_PORT=8080
SITE_URL="http://localhost:8080"
SITE_TITLE="Adoption Curriculum"
